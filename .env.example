# =====================================================================
# RENDER BACKEND ENVIRONMENT VARIABLES
# Set these in the Render Dashboard (Web Service -> Environment)
# =====================================================================

# Required: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model
GEMINI_PRIMARY_MODEL=gemini-2.5-flash

# Model Fallback Priority (comma-separated)
MODELS_PRIORITY=gemini-2.5-flash,gemini-2.0-flash,gemini-flash-latest

# Python Version
PYTHON_VERSION=3.11.9

# Allowed Origins for CORS (optional, leave blank or specify Vercel domain)
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# CORS Regex for Vercel Preview Deployments (preconfigured by default)
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$|^https:\/\/.*\.onrender\.com$|^http:\/\/localhost(:\d+)?$|^http:\/\/127\.0\.0\.1(:\d+)?$

# Concurrency & Timeouts
MAX_WORKERS=10
DOWNLOAD_TIMEOUT=15
OCR_TIMEOUT=20
AI_TIMEOUT=45
RETRY_COUNT=3
