# =====================================================================
# VERCEL FRONTEND ENVIRONMENT VARIABLES
# Set these in the Vercel Dashboard (Project Settings -> Environment Variables)
# =====================================================================

# Required: Public URL of your deployed Render backend (no trailing slash)
# Example: https://agentic-ai-backend.onrender.com
VITE_API_BASE_URL=https://your-backend-app.onrender.com

# Optional: WebSocket URL (will auto-infer wss:// from VITE_API_BASE_URL if omitted)
# Example: wss://agentic-ai-backend.onrender.com/ws
VITE_WS_URL=wss://your-backend-app.onrender.com/ws
